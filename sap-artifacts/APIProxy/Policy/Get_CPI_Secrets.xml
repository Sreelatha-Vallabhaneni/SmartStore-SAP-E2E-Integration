<KeyValueMapOperations mapIdentifier="CPI_Credentials_KVM" async="false" continueOnError="false" enabled="true" xmlns="http://www.sap.com/apimgmt">
    <Get assignTo="private.cpi_user">
        <Key>
            <Parameter>cpi_client_id</Parameter>
        </Key>
    </Get>
    <Get assignTo="private.cpi_pass">
        <Key>
            <Parameter>cpi_client_secret</Parameter>
        </Key>
    </Get>
    <Scope>environment</Scope>
</KeyValueMapOperations>
